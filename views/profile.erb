<div class="card">
  <h2>プロフィール</h2>

  <p><strong>ユーザー名:</strong> <%= @user['username'] %></p>
  <p><strong>登録日:</strong> <%= @user['created_at'] %></p>

  <% if @user['icon_path'] %>
    <p><strong>アイコン:</strong></p>
    <img src="/uploads/<%= @user['icon_path'] %>" alt="icon" style="max-width: 150px; border-radius: 8px;">
  <% else %>
    <p style="color: #999;">アイコンは未設定です（第4回で実装予定）</p>
  <% end %>
</div>
